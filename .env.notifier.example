# cmd/notifier — email sender microservice
PORT=8081
GIN_MODE=release

RESEND_API_KEY=
EMAIL_FROM=you@yourdomain.com
RESEND_API_URL=https://api.resend.com/emails

# Shared secret for service-to-service auth from the main server.
# Must match NOTIFIER_INTERNAL_TOKEN in .env.server. Leave empty to disable.
NOTIFIER_INTERNAL_TOKEN=
