          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="scanner" style="endArrow=block;html=1;" target="github" value="HTTPS GET&#xa;fetch latest release tag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="scanner" style="endArrow=block;html=1;" target="resend" value="HTTPS POST&#xa;send release notification emails">
