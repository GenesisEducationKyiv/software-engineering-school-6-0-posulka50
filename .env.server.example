# cmd/server — main API + scheduler
PORT=8080
GIN_MODE=release
API_KEY=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/github_notifier?sslmode=disable
REDIS_URL=redis://localhost:6379

GITHUB_TOKEN=

NOTIFIER_URL=http://localhost:8081
# Shared secret for service-to-service auth with the notifier.
# Must match NOTIFIER_INTERNAL_TOKEN in .env.notifier. Leave empty to disable.
NOTIFIER_INTERNAL_TOKEN=

BASE_URL=http://localhost:8080
SCAN_INTERVAL=1h
