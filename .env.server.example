# cmd/server — main API + scheduler
PORT=8080
GIN_MODE=release
API_KEY=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/github_notifier?sslmode=disable
REDIS_URL=redis://localhost:6379

GITHUB_TOKEN=

BROKER_URL=amqp://guest:guest@localhost:5672/

# Address of the notifier service's gRPC listener, used by the timeout
# sweeper to make a synchronous retry attempt before compensating a stuck
# Subscribe saga. Must match NOTIFIER_GRPC_PORT in .env.notifier.
NOTIFIER_GRPC_ADDR=localhost:50051

BASE_URL=http://localhost:8080
SCAN_INTERVAL=1h

# Subscribe-saga timeout tuning.
SAGA_TIMEOUT=5m
SAGA_SWEEP_INTERVAL=30s
