# Server (cmd/server)
PORT=8080
API_KEY=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/github_notifier?sslmode=disable
REDIS_URL=redis://localhost:6379

GITHUB_TOKEN=

BROKER_URL=amqp://guest:guest@localhost:5672/

# Address of the notifier service's gRPC listener (used by the sweeper to
# attempt a sync retry before compensating a stuck Subscribe saga).
NOTIFIER_GRPC_ADDR=localhost:50051

BASE_URL=http://localhost:8080
SCAN_INTERVAL=1h

# Notifier (cmd/notifier)
NOTIFIER_GRPC_PORT=50051
RESEND_API_KEY=
EMAIL_FROM=you@yourdomain.com
RESEND_API_URL=https://api.resend.com/emails
